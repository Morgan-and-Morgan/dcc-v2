#!/bin/bash

set -eo pipefail

#
# This script runs static tests which
# can be performed without code execution.
#
# Some example are code sniffing and unit testing
#

# Run composer install to get the vendor directory
composer install --no-ansi --no-interaction --optimize-autoloader --no-progress

# Run unit tests
composer -n unit-test

# The `git clean -fdX web` that used to sit here has been dropped. It removed
# every gitignored path under web/ — which is the Drupal core,
# contrib module and contrib theme tree Composer had just installed one step
# above — purely to keep third-party code out of the sniff. That is already
# handled by targeting: lint and code-sniff only ever walk web/modules/custom
# and web/themes/custom, and code-sniff additionally ignores node_modules,
# vendor and dist.

# Lint php code for syntax errors (targets web/modules/custom and web/themes/custom only)
composer -n lint

# Check coding standards (targets web/modules/custom and web/themes/custom only)
composer -n code-sniff
