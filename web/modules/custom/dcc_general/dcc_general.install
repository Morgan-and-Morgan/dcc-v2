<?php

/**
 * @file
 * Install, update and uninstall functions for the Nationlaw Updates module.
 */

use Drupal\node\NodeInterface;

/**
 * @file
 * Install, update and uninstall functions for the Nationlaw Updates module.
 */

/**
 * Remove the all needed $modules_to_delete from the system.
 */
function dcc_general_update_9001() {
  $modules_to_remove = [
    'drupal_ftp_global_vars',
    'kint',
  ];

  $config_name = 'core.extension';

  // Load the existing configuration.
  $config = \Drupal::configFactory()->getEditable($config_name);

  // Get the current list of enabled modules.
  $enabled_modules = $config->get('module') ?? [];

  // Disable the specified modules.
  foreach ($modules_to_remove as $module) {
    if (isset($enabled_modules[$module])) {
      unset($enabled_modules[$module]);
    }
  }

  // Update the configuration with the new list of enabled modules.
  $config->set('module', $enabled_modules);
  $config->save();

  // Remove from db.
  foreach ($modules_to_remove as $module_name) {
    // Execute the SQL query to retrieve data from the key_value table.
    $query = \Drupal::database()->select('key_value', 'kv')
      ->fields('kv', ['name'])
      ->condition('collection', 'system.schema')
      ->condition('name', $module_name)
      ->execute();

    // Fetch the results.
    $results = $query->fetchAll();

    // Log the results to the watchdog for debugging purposes.
    if (!empty($results)) {
      foreach ($results as $record) {
        \Drupal::logger('mymodule')->info('Module found: @module', ['@module' => $record->name]);
      }
    }
    else {
      \Drupal::logger('mymodule')->warning('No modules found in the "system.schema" collection.');
    }
  }

  // Return an informative message.
  return t('Checked and logged modules in the "system.schema" collection.');
}

/**
 * Create or update the Privacy Policy page at /privacy-policy/.
 */
function dcc_general_update_9002() {
  $alias = '/privacy-policy';
  $content_file = __DIR__ . '/content/privacy-policy.html';

  if (!is_readable($content_file)) {
    throw new \RuntimeException(sprintf('Privacy policy content file not found: %s', $content_file));
  }

  $body = file_get_contents($content_file);
  if ($body === FALSE || $body === '') {
    throw new \RuntimeException(sprintf('Privacy policy content file is empty: %s', $content_file));
  }

  $path = \Drupal::service('path_alias.manager')->getPathByAlias($alias);
  $node = NULL;

  if (preg_match('/^\/node\/(\d+)$/', $path, $matches)) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($matches[1]);
  }

  if ($node instanceof NodeInterface) {
    $node->set('body', [
      'value' => $body,
      'format' => 'full_html',
    ]);
    $node->save();

    return t('Updated existing Privacy Policy page at @alias.', ['@alias' => $alias]);
  }

  $node = \Drupal::entityTypeManager()->getStorage('node')->create([
    'type' => 'page',
    'title' => 'Privacy Policy',
    'status' => 1,
    'promote' => 0,
    'sticky' => 0,
    'uid' => 1,
    'langcode' => 'en',
    'body' => [
      'value' => $body,
      'format' => 'full_html',
    ],
    'path' => [
      'alias' => $alias,
      'langcode' => 'en',
    ],
  ]);
  $node->save();

  return t('Created Privacy Policy page at @alias.', ['@alias' => $alias]);
}

/**
 * Implements hook_update_dependencies().
 */
function dcc_general_update_dependencies(): array {
  // Contrib tour (required only so it can be uninstalled) has pending updates
  // on the live database. Let them finish before update_11001 uninstalls
  // tour, otherwise they fail with tour no longer installed. Ignored when
  // tour has no pending updates or its code is absent.
  $dependencies['dcc_general'][11001] = [
    'tour' => 10311,
  ];
  return $dependencies;
}

/**
 * WEM-7114: Uninstall tour, profile_switcher, env_libraries and ckeditor.
 *
 * - tour: removed from core in Drupal 11.
 * - profile_switcher, env_libraries: dropped from shared infra drupal11, no
 *   Drupal 11 release.
 * - ckeditor: CKEditor 4, no Drupal 11 release; no text format uses it.
 *
 * The site requires tour and profile_switcher (lenient) only so this update
 * can uninstall them. Safe to re-run. If a module's code is already gone,
 * only its core.extension entry is removed.
 */
function dcc_general_update_11001(): string {
  $module_handler = \Drupal::moduleHandler();
  $module_list = \Drupal::service('extension.list.module');
  $messages = [];
  foreach (['tour', 'profile_switcher', 'env_libraries', 'ckeditor'] as $module) {
    if (!$module_handler->moduleExists($module)) {
      $messages[] = $module . ' is not installed.';
      continue;
    }
    if ($module_list->exists($module)) {
      \Drupal::service('module_installer')->uninstall([$module]);
      $messages[] = $module . ' uninstalled.';
      continue;
    }
    // Code already removed: drop the stale core.extension entry.
    \Drupal::configFactory()->getEditable('core.extension')
      ->clear('module.' . $module)
      ->save();
    \Drupal::keyValue('system.schema')->delete($module);
    $messages[] = $module . ' removed from core.extension (code missing).';
  }
  return implode(' ', $messages);
}
