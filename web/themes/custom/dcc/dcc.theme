 */

use Drupal\Component\Utility\Html;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function dcc_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (\Drupal::routeMatch()->getParameter('node')) {
    $node = \Drupal::routeMatch()->getParameter('node');
    $contentTypeName = $node->bundle();
    $current_uri = \Drupal::request()->getRequestUri();
    // Removes all slashes from uri.
    $clean_uri = preg_replace("~/~", "", $current_uri);
    // Replaces hyphens with underscores.
    $suggestions[] = 'page__' . preg_replace("~-~", "_", $clean_uri);
    $suggestions[] = 'page__type__' . $contentTypeName;
  }
}

/**
 * Implements hook_preprocess_html().
 */
function dcc_preprocess_html(&$variables) {
  $current_path = \Drupal::service('path.current')->getPath();
  $current_path = \Drupal::service('path.current')->getPath();
  $path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $path_alias = ltrim($path_alias, '/');
  $variables['attributes']['class'][] = 'path-' . Html::cleanCssIdentifier($path_alias);
  if (isset($variables['node_type'])) {
    // Add node-TYPE class to the <body> element.
    $variables['attributes']['class'][] = 'node-type-' . $variables['node_type'];
  }

}

/**
 * Implements hook_preprocess_paragraph().
 */
function dcc_preprocess_paragraph(&$variables) {
  $node = \Drupal::request()->attributes->get('node');
  $variables['nodetitle'] = $node->getTitle();
}

/**
 * Implements hook_library_info_alter().
 *
 * we_megamenu 8.x-1.17 replaced the Bootstrap 3 CSS bundled in its frontend
 * library with Bootstrap 5.3.3 from a CDN. The header mega menu markup
 * (.navbar-toggle, .icon-bar, .navbar-default) and the dcc theme styles were
 * built against Bootstrap 3, so with Bootstrap 5 the nav lost its layout and
 * the mobile hamburger icon. Put back the Bootstrap 3 file the module still
 * ships, in the same position, so it keeps its pre-1.17 place in the cascade
 * (ahead of we_megamenu_backend.css, which resets html font-size to 100%).
 */
function dcc_library_info_alter(array &$libraries, $extension) {
  if ($extension !== 'we_megamenu' || empty($libraries['form.we-mega-menu-frontend']['css']['theme'])) {
    return;
  }
  $cdn = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css';
  $local = 'assets/includes/bootstrap/css/bootstrap.min.css';
  $css = $libraries['form.we-mega-menu-frontend']['css']['theme'];
  if (!array_key_exists($cdn, $css)) {
    return;
  }
  $altered = [];
  foreach ($css as $file => $options) {
    if ($file === $cdn) {
      $altered[$local] = [];
    }
    else {
      $altered[$file] = $options;
    }
  }
  $libraries['form.we-mega-menu-frontend']['css']['theme'] = $altered;
}
