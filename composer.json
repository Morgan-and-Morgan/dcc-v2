{
    "name": "pantheon-systems/example-drops-8-composer",
    "description": "Install drops-8 with Composer on Pantheon.",
    "type": "project",
    "license": "MIT",
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "mm-drupal-core-d9": {
            "type": "git",
            "url": "git@github.com:morgan-and-morgan/mm-drupal-core-d9-shared-infra.git"
        },
        "bower-asset": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        "lazysizes": {
            "type": "package",
            "package": {
                "name": "afarkas/lazysizes",
                "version": "5.3.1",
                "type": "drupal-library",
                "dist": {
                    "type": "zip",
                    "url": "https://github.com/aFarkas/lazysizes/archive/refs/tags/5.3.1.zip"
                }
            }
        }
    },
    "require": {
        "php": ">=8.3",
        "drupal/config_delete": "^2.0",
        "drupal/config_devel": "^1.8",
        "drupal/context_entity_field": "^2.0@alpha",
        "drupal/default_paragraphs": "^2.0",
        "drupal/field_states_ui": "^3.0",
        "drupal/fontawesome": "^3.0",
        "drupal/honeypot": "^2.0",
        "drupal/key": "^1.14",
        "drupal/menu_block": "^1.6",
        "drupal/menus_attribute": "^1.1",
        "drupal/migrate_tools": "^6.1.5",
        "drupal/profile_switcher": "^1.0@alpha",
        "drupal/sfweb2lead_webform": "^6.0",
        "drupal/shortcode": "^2.0",
        "drupal/tb_megamenu": "^1.0@RC",
        "drupal/tour": "^3.0",
        "drupal/upgrade_status": "^4.3",
        "drupal/we_megamenu": "1.17.0",
        "drupal/webform": "^6.0",
        "drupal/xmlsitemap": "^2.0",
        "enshrined/svg-sanitize": "1.0.0 as 0.22.1",
        "mglaman/composer-drupal-lenient": "^1.0",
        "morgan-and-morgan/mm_drupal_core_d9_shared_infra": "dev-drupal11",
        "symfony/http-client": "^7.3"
    },
    "require-dev": {
        "drupal/coder": "^8.3.24"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::rememberLock",
            "DrupalProject\\composer\\ScriptHandler::checkLocklessMerge"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkLocklessMerge"
        ],
        "build-assets": [
            "@prepare-for-pantheon",
            "composer install --optimize-autoloader --no-dev",
            "@build-theme-dcc"
        ],
        "lint": "find web/modules/custom web/themes/custom -name '*.php' -exec php -l {} \\;",
        "code-sniff": [
            "./vendor/bin/phpcs --standard=Drupal --extensions=php,module,inc,install,test,profile,theme,css,info,txt,md --ignore=node_modules,bower_components,vendor ./web/modules/custom",
            "./vendor/bin/phpcs --standard=Drupal --extensions=php,module,inc,install,test,profile,theme,css,info,txt,md --ignore=node_modules,bower_components,vendor,dist ./web/themes/custom",
            "./vendor/bin/phpcs --standard=DrupalPractice --extensions=php,module,inc,install,test,profile,theme,css,info,txt,md --ignore=node_modules,bower_components,vendor ./web/modules/custom",
            "./vendor/bin/phpcs --standard=DrupalPractice --extensions=php,module,inc,install,test,profile,theme,css,info,txt,md --ignore=node_modules,bower_components,vendor,dist ./web/themes/custom"
        ],
        "unit-test": "echo 'No unit test step defined.'",
        "prepare-for-pantheon": "DrupalProject\\composer\\ScriptHandler::prepareForPantheon",
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "DrupalProject\\composer\\ScriptHandler::restoreLockAfterInstall",
            "DrupalProject\\composer\\ScriptHandler::completeLocklessMerge"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "DrupalProject\\composer\\ScriptHandler::completeLocklessMerge"
        ],
        "post-create-project-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "@build-theme-dcc"
        ],
        "build-theme-dcc": [
            "cd web/themes/custom/dcc; rm -Rf web/theme/custom/dcc/dist; npm -v; node -v; npm install --unsafe-perm; npm rebuild node-sass; npm run build;"
        ],
        "nuke-profile": [
            "rm -Rf web/profiles/contrib/ vendor/ composer.lock",
            "@bootstrap-plugins"
        ],
        "nuke-site": [
            "rm -Rf web/profiles/contrib/ vendor/ composer.lock web/themes/contrib web/theme/custom/dcc/dist web/theme/custom/dcc/node_modules",
            "@bootstrap-plugins"
        ],
        "nuke-rebuild": [
            "composer nuke-site",
            "composer install",
            "composer build-theme-dcc"
        ],
        "bootstrap-plugins": "COMPOSER_VENDOR_DIR=\"$PWD/vendor\" composer --working-dir=scripts/composer/plugins-bootstrap install --no-interaction --no-progress"
    },
    "extra": {
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/private/scripts/quicksilver/{$name}/": [
                "type:quicksilver-script"
            ]
        },
        "build-env": {
            "install-cms": [
                "drush site-install standard --account-mail={account-mail} --account-name={account-name} --account-pass={account-pass} --site-mail={site-mail} --site-name={site-name} --yes"
            ],
            "export-configuration": "drush config-export --yes"
        },
        "drupal-scaffold": {
            "allowed-packages": [
                "pantheon-systems/drupal-integrations"
            ],
            "locations": {
                "web-root": "./web"
            },
            "file-mapping": {
                "[project-root]/.editorconfig": false
            }
        },
        "patches": {
            "drupal/field_states_ui": {
                "Drupal 11 compatibility (https://www.drupal.org/project/field_states_ui/issues/3430531, MR !12)": "patches/field_states_ui-d11-compat-3430531.patch"
            },
            "drupal/menus_attribute": {
                "Drupal 11 compatibility (https://www.drupal.org/project/menus_attribute/issues/3433358, MR !18)": "patches/menus_attribute-d11-compat-3433358.patch"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/field_states_ui",
                "drupal/menus_attribute",
                "drupal/profile_switcher",
                "drupal/views_complex_grouping"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "zaporylie/composer-drupal-optimizations": true,
            "mglaman/composer-drupal-lenient": true,
            "drupal/core-recipe-unpack": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    }
}
